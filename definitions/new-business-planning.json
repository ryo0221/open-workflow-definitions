{
  "format": 1,
  "id": "new-business-planning",
  "version": "1.0.0",
  "title": "新規事業の企画",
  "purpose": "会社の新規事業を、要る仕事の洗い出しから、機会の探索・仮説・市場と顧客・事業モデル・実行の計画・収支・リスク・投資の判断を経て、事業計画書と説明の資料にまとめ、経営の判断を受ける。数字は種類と出典を分けて持ち、説明の資料の数字から前提と出典までたどれる形にする。題材・手法・道具・出力形式は利用側が決める。",
  "phases": [
    {
      "id": "process",
      "name": "進め方",
      "purpose": "対象の事業領域と出口、工程と成果物、承認の決め方（どの組織から何人）、ゲート、組織ごとに見せる範囲、AIに委ねる範囲を決める。工程そのものも、要る仕事を枝に広げて整理してから決める。",
      "after": [],
      "deliverables": [
        "process-map"
      ],
      "acceptance": [
        "process.complete",
        "process.traced",
        "process.approved"
      ]
    },
    {
      "id": "opportunity",
      "name": "機会の探索",
      "purpose": "市場の変化・社会の課題・自社の強みと資産を枝に広げ、事業の機会を一件ずつ取り出し、選んだ機会と捨てた機会の理由を書く。",
      "after": [
        "process"
      ],
      "deliverables": [
        "opportunity-map"
      ],
      "acceptance": [
        "opportunity.complete",
        "opportunity.traced",
        "opportunity.approved"
      ]
    },
    {
      "id": "hypothesis",
      "name": "事業の仮説",
      "purpose": "選んだ機会について、顧客・課題・提供する価値・収益の仕組みの仮説と、その確かめ方を書く。探索を続けるかを決める最初のゲート。",
      "after": [
        "opportunity"
      ],
      "deliverables": [
        "hypotheses"
      ],
      "acceptance": [
        "hypothesis.complete",
        "hypothesis.traced",
        "hypothesis.gate"
      ]
    },
    {
      "id": "market",
      "name": "市場と顧客",
      "purpose": "市場の規模と伸び、顧客の話、競合を、数字の種類（実績・予測・仮定・計算）と出典を分けて集め、仮説を確かめる。",
      "after": [
        "hypothesis"
      ],
      "deliverables": [
        "market-research"
      ],
      "acceptance": [
        "market.complete",
        "market.sourced",
        "market.traced",
        "market.approved"
      ]
    },
    {
      "id": "business-model",
      "name": "事業モデル",
      "purpose": "価値の流れの中での自社の位置、関係者（顧客・提携先・調達先・規制当局など）と、物・お金・情報の流れを決める。",
      "after": [
        "market"
      ],
      "deliverables": [
        "business-model-map"
      ],
      "acceptance": [
        "business-model.complete",
        "business-model.traced",
        "business-model.approved"
      ]
    },
    {
      "id": "execution",
      "name": "実行の計画",
      "purpose": "拠点・物流・設備・人・立ち上げの日程を、事業モデルを実行できる形にする。提携先と共同で作るときは、見せる範囲を分けて作る。",
      "after": [
        "business-model"
      ],
      "deliverables": [
        "execution-plan"
      ],
      "acceptance": [
        "execution.complete",
        "execution.traced",
        "execution.approved"
      ]
    },
    {
      "id": "business-case",
      "name": "収支計画",
      "purpose": "前提を一件ずつ置き、年次の収支・資金・投資の指標を計算し、シナリオと感応度で比べる。結果は使った前提と計算モデルの版から再計算できる形にする。",
      "after": [
        "business-model",
        "execution"
      ],
      "deliverables": [
        "business-case-model"
      ],
      "acceptance": [
        "business-case.complete",
        "business-case.sourced",
        "business-case.recomputable",
        "business-case.traced",
        "business-case.approved"
      ]
    },
    {
      "id": "risk",
      "name": "リスクと対策",
      "purpose": "事業・市場・提携・規制・為替・国・実行のリスクを一件ずつ、影響・起きやすさ・対策・担当として書き、どの前提や計画に効くかを結ぶ。",
      "after": [
        "business-case"
      ],
      "deliverables": [
        "risk-register"
      ],
      "acceptance": [
        "risk.complete",
        "risk.traced",
        "risk.approved"
      ]
    },
    {
      "id": "investment",
      "name": "投資の判断",
      "purpose": "段階ごとの投資額、追う指標、撤退の基準を決め、投資を審査する人たちが承認する。",
      "after": [
        "business-case",
        "risk"
      ],
      "deliverables": [
        "investment-decision"
      ],
      "acceptance": [
        "investment.complete",
        "investment.traced",
        "investment.committee"
      ]
    },
    {
      "id": "plan-document",
      "name": "事業計画書",
      "purpose": "ここまでの成果物を引いて、事業計画書にまとめる。数字と主張はすべて、もとの項目と版を引く。",
      "after": [
        "investment"
      ],
      "deliverables": [
        "business-plan"
      ],
      "acceptance": [
        "plan-document.complete",
        "plan-document.traced",
        "plan-document.consistent",
        "plan-document.approved"
      ]
    },
    {
      "id": "deck",
      "name": "説明の資料",
      "purpose": "事業計画書から、決める人に説明する資料（スライドと発表者の原稿・想定問答）を作る。数字は受け入れた計画書と収支の版を引く。",
      "after": [
        "plan-document"
      ],
      "deliverables": [
        "presentation-deck"
      ],
      "acceptance": [
        "deck.complete",
        "deck.traced",
        "deck.consistent",
        "deck.readable",
        "deck.approved"
      ]
    },
    {
      "id": "decision",
      "name": "経営の判断",
      "purpose": "経営として実行するかを決め、条件と実行の項目を記録する。",
      "after": [
        "deck"
      ],
      "deliverables": [
        "decision-record"
      ],
      "acceptance": [
        "decision.complete",
        "decision.traced",
        "decision.approved"
      ]
    },
    {
      "id": "learning",
      "name": "学び",
      "purpose": "この企画で分かったことを、次の企画と工程の定義への直しとして残す。",
      "after": [
        "decision"
      ],
      "deliverables": [
        "learning-notes"
      ],
      "acceptance": [
        "learning.complete",
        "learning.approved"
      ]
    }
  ],
  "sections": [
    {
      "id": "explore",
      "name": "探索",
      "phases": [
        "process",
        "opportunity",
        "hypothesis"
      ]
    },
    {
      "id": "validate",
      "name": "確かめと設計",
      "phases": [
        "market",
        "business-model",
        "execution",
        "business-case",
        "risk",
        "investment"
      ]
    },
    {
      "id": "conclude",
      "name": "まとめと説明",
      "phases": [
        "plan-document",
        "deck",
        "decision"
      ]
    },
    {
      "id": "reflect",
      "name": "学び",
      "phases": [
        "learning"
      ]
    }
  ],
  "deliverables": [
    {
      "id": "process-map",
      "name": "進め方",
      "form": "図・文書",
      "outline": [
        {
          "heading": "対象と出口",
          "describe": "対象の事業領域、企画の範囲、完成とする状態（経営の判断を受けるまで、など）"
        },
        {
          "heading": "要る仕事",
          "describe": "この企画で要る仕事・成果物・判断を、枝に広げて一件ずつ。欄 parent に親の枝、欄 kind に仕事・成果物・判断・条件の別、欄 by に枝を足した役割（企画・財務・法務など）を書く",
          "item": "need"
        },
        {
          "heading": "工程と成果物",
          "describe": "使う工程、省く工程と理由、代わりの確認、繰り返す工程。どの枝がどの工程・成果物・達成条件になったかの対応"
        },
        {
          "heading": "承認とゲート",
          "describe": "工程ごとに承認する人、どの組織から何人の承認が要るか、ゲートで見ること"
        },
        {
          "heading": "見せる範囲",
          "describe": "組織ごとに見せる成果物と見せない成果物、範囲を分ける単位、受け渡す版"
        },
        {
          "heading": "責任とAIの関与",
          "describe": "AIに任せる作業と、人が判断すること"
        },
        {
          "heading": "公開と権利",
          "describe": "題材が架空か実在か、実在の会社・人・製品との関係の断り、使う情報の出典の扱い"
        }
      ],
      "uses": [],
      "view": {
        "as": "mindmap",
        "items": "need",
        "parent": "parent",
        "colorBy": "by"
      }
    },
    {
      "id": "opportunity-map",
      "name": "機会の探索",
      "form": "図",
      "outline": [
        {
          "heading": "探索の枝",
          "describe": "市場の変化・社会の課題・自社の強みと資産・規制や技術の動きを、枝に広げて一件ずつ。欄 parent に親の枝、欄 kind に変化・課題・強み・動き・着想の別を書く",
          "item": "branch"
        },
        {
          "heading": "機会",
          "describe": "枝から取り出した事業の機会を一件ずつ。もとにした枝、選んだか捨てたか、その理由",
          "item": "opportunity"
        }
      ],
      "uses": [
        "process-map"
      ],
      "view": [
        {
          "as": "mindmap",
          "items": "branch",
          "parent": "parent",
          "layout": "radial",
          "colorBy": "kind"
        },
        {
          "as": "table",
          "items": "opportunity",
          "columns": [
            "name",
            "状態",
            "理由"
          ]
        }
      ]
    },
    {
      "id": "hypotheses",
      "name": "事業の仮説",
      "form": "表",
      "outline": [
        {
          "heading": "仮説",
          "describe": "顧客・課題・提供する価値・収益の仕組みの仮説を一件ずつ。もとにした機会、確かめ方、確かめた結果（後の工程で書き足す）",
          "item": "hypothesis"
        },
        {
          "heading": "ゲートの判断",
          "describe": "探索を続けるか、どの仮説を確かめるか、判断した人と日付"
        }
      ],
      "uses": [
        "opportunity-map"
      ],
      "view": {
        "as": "table",
        "items": "hypothesis",
        "columns": [
          "name",
          "顧客",
          "課題",
          "価値",
          "確かめ方",
          "状態"
        ]
      }
    },
    {
      "id": "market-research",
      "name": "市場と顧客",
      "form": "表・文書",
      "outline": [
        {
          "heading": "市場の数字",
          "describe": "市場の規模と伸び（全体・狙える範囲・取れる範囲など）を一件ずつ。欄 kind に実績・予測・仮定・計算の別を書き、実績は出典・地域・年・単位、予測は出典と予測の条件、仮定は理由と幅、計算は使った数字を書く",
          "item": "market-figure"
        },
        {
          "heading": "顧客の話",
          "describe": "顧客や関係者から聞いたことを一件ずつ。誰の話か（属性）、どの仮説を確かめたか、確かめた・崩れた・分からないの別",
          "item": "customer-note"
        },
        {
          "heading": "競合と代わり",
          "describe": "競合と、顧客が今使っている代わりの手段を一件ずつ。強み、弱み、どの仮説に効くか",
          "item": "competitor"
        }
      ],
      "uses": [
        "hypotheses"
      ],
      "view": [
        {
          "as": "table",
          "items": "market-figure",
          "groupBy": "kind"
        },
        {
          "as": "kanban",
          "items": "customer-note",
          "groupBy": "結果",
          "columns": [
            "確かめた",
            "崩れた",
            "分からない"
          ]
        }
      ]
    },
    {
      "id": "business-model-map",
      "name": "事業モデル",
      "form": "図",
      "outline": [
        {
          "heading": "関係者",
          "describe": "自社・顧客・提携先・調達先・規制当局などを一件ずつ。欄 kind に役割、欄 in に入る領域（国や事業の区分）を書く",
          "item": "actor"
        },
        {
          "heading": "流れ",
          "describe": "関係者の間の物・お金・情報の流れを一件ずつ。欄 from・to に関係者の ID、欄 kind に物・お金・情報の別",
          "item": "value-flow"
        },
        {
          "heading": "領域",
          "describe": "国や事業の区分など、関係者をまとめる枠を一件ずつ",
          "item": "domain"
        },
        {
          "heading": "自社の位置",
          "describe": "価値の流れの中で自社が担うこと、担わないこと、取り分の考え方"
        }
      ],
      "uses": [
        "market-research"
      ],
      "view": {
        "as": "graph",
        "sections": [
          "domain"
        ],
        "nodes": [
          "actor"
        ],
        "edges": [
          "value-flow"
        ],
        "colorBy": "kind",
        "edgeColorBy": "kind"
      }
    },
    {
      "id": "execution-plan",
      "name": "実行の計画",
      "form": "地図・日程・文書",
      "outline": [
        {
          "heading": "拠点",
          "describe": "事務所・倉庫・工場・回収の場所などを一件ずつ。場所、役割、規模、受け持つ関係者",
          "item": "site"
        },
        {
          "heading": "経路",
          "describe": "拠点の間の物の流れを一件ずつ。欄 from・to に拠点の ID、量、手段",
          "item": "route"
        },
        {
          "heading": "設備と人",
          "describe": "拠点ごとの設備・人の計画。工場のモデルなど別の成果物があればその版"
        },
        {
          "heading": "節目",
          "describe": "立ち上げの日程の節目を一件ずつ。欄 start・end に日付（YYYY-MM-DD）、担当",
          "item": "milestone"
        },
        {
          "heading": "共同で作る範囲",
          "describe": "提携先と共同で作る部分、見せる範囲、受け渡した版"
        }
      ],
      "uses": [
        "business-model-map"
      ],
      "view": [
        {
          "as": "graph",
          "nodes": [
            "site"
          ],
          "edges": [
            "route"
          ],
          "colorBy": "kind"
        },
        {
          "as": "timeline",
          "items": "milestone",
          "start": "start",
          "end": "end",
          "groupBy": "担当",
          "scale": "month"
        }
      ]
    },
    {
      "id": "business-case-model",
      "name": "収支計画",
      "form": "収支",
      "outline": [
        {
          "heading": "計算の条件",
          "describe": "期間・年次か月次か・基準の通貨・割引率・税・丸めの決まり・計算モデルの版"
        },
        {
          "heading": "前提",
          "describe": "収支を決める数字を一件ずつ。値・単位・通貨、欄 kind に実績・予測・仮定・条件の別、出典か理由、想定する幅",
          "item": "assumption"
        },
        {
          "heading": "シナリオ",
          "describe": "基本・楽観・悲観などを一件ずつ。どの前提をどの値に変えるか",
          "item": "scenario"
        },
        {
          "heading": "計算結果",
          "describe": "シナリオごとの年次の売上・費用・投資・資金の動きと、投資の指標（正味現在価値・内部収益率・回収年など）を一件ずつ。使った前提と計算モデルの版",
          "item": "result"
        },
        {
          "heading": "感応度",
          "describe": "主な前提を幅の中で動かしたとき、指標がどれだけ動くか。効く順"
        }
      ],
      "uses": [
        "business-model-map",
        "execution-plan",
        "market-research"
      ],
      "view": [
        {
          "as": "table",
          "items": "assumption",
          "groupBy": "kind",
          "columns": [
            "name",
            "値",
            "単位",
            "kind",
            "出典",
            "幅"
          ]
        }
      ]
    },
    {
      "id": "risk-register",
      "name": "リスクと対策",
      "form": "表",
      "outline": [
        {
          "heading": "リスク",
          "describe": "リスクを一件ずつ。欄 category（事業・市場・提携・規制・為替・国・実行）、影響、起きやすさ、対策、担当、効く前提や計画",
          "item": "risk"
        }
      ],
      "uses": [
        "business-case-model",
        "execution-plan",
        "business-model-map"
      ],
      "view": {
        "as": "table",
        "items": "risk",
        "groupBy": "category",
        "columns": [
          "name",
          "影響",
          "起きやすさ",
          "対策",
          "担当"
        ],
        "sort": [
          {
            "by": "影響",
            "desc": true
          }
        ]
      }
    },
    {
      "id": "investment-decision",
      "name": "投資の判断",
      "form": "表・文書",
      "outline": [
        {
          "heading": "段階の投資",
          "describe": "段階ごとの投資額、次の段階へ進む条件",
          "item": "stage"
        },
        {
          "heading": "追う指標",
          "describe": "事業の進み具合を見る指標を一件ずつ。目標の値と測り方",
          "item": "kpi"
        },
        {
          "heading": "撤退の基準",
          "describe": "やめる・見直す条件を一件ずつ。どの指標や前提を見て、いつ判断するか",
          "item": "exit-criterion"
        },
        {
          "heading": "審査",
          "describe": "審査した人と組織、承認・差し戻し・条件、差し戻したときの直し"
        }
      ],
      "uses": [
        "business-case-model",
        "risk-register"
      ],
      "view": {
        "as": "table",
        "items": "exit-criterion",
        "columns": [
          "name",
          "見る指標",
          "判断の時期"
        ]
      }
    },
    {
      "id": "business-plan",
      "name": "事業計画書",
      "form": "文書",
      "outline": [
        {
          "heading": "要旨",
          "describe": "事業の一文、なぜ自社か、数字の要点、求める判断"
        },
        {
          "heading": "主張",
          "describe": "計画書の主張を一件ずつ。もとにした項目（数字は前提・計算結果の版）",
          "item": "claim"
        },
        {
          "heading": "本文",
          "describe": "事業の背景・機会・仮説と確かめ・市場・事業モデル・実行・収支・リスク・投資と撤退の章"
        }
      ],
      "uses": [
        "investment-decision",
        "business-case-model",
        "risk-register",
        "execution-plan",
        "business-model-map",
        "market-research",
        "hypotheses"
      ]
    },
    {
      "id": "presentation-deck",
      "name": "説明の資料",
      "form": "スライド",
      "outline": [
        {
          "heading": "スライド",
          "describe": "説明のスライドを一枚ずつ。伝えること、載せる数字と図、もとにした主張、動きの順",
          "item": "slide"
        },
        {
          "heading": "発表者の原稿",
          "describe": "スライドごとの話す言葉。数字の読み方"
        },
        {
          "heading": "想定問答",
          "describe": "決める人から出そうな問いと答えを一件ずつ。もとにした主張やリスク",
          "item": "qa"
        }
      ],
      "uses": [
        "business-plan"
      ],
      "view": {
        "as": "table",
        "items": "slide",
        "columns": [
          "name",
          "伝えること",
          "動き"
        ]
      }
    },
    {
      "id": "decision-record",
      "name": "経営の判断",
      "form": "文書",
