{
  "format": 1,
  "id": "construction-planning",
  "version": "1.0.0",
  "title": "施工計画",
  "purpose": "建物や塔・橋などの構造物を、設計の情報と敷地の条件から、どう分けて、どの順に、どの機械と経路で建てるかを計画し、その計画を日付ごとの模型で動かして揚重・搬入・安全・施工中の構造を確かめ、承認を経て関係者に説明できる形にする。題材・工法・道具・出力形式は利用側が決める。",
  "phases": [
    {
      "id": "process",
      "name": "進め方",
      "purpose": "対象と範囲、工程、省略・反復の扱い、AIに委ねる範囲、承認責任者と完成の出口を決める。",
      "after": [],
      "deliverables": [
        "process-map"
      ],
      "acceptance": [
        "process.complete",
        "process.approved"
      ]
    },
    {
      "id": "conditions",
      "name": "与条件の整理",
      "purpose": "設計の情報・敷地と周辺・工期・法令と近隣の約束・公開情報の確からしさを、計画が守る条件として一件ずつ書く。",
      "after": [
        "process"
      ],
      "deliverables": [
        "site-conditions"
      ],
      "acceptance": [
        "conditions.complete",
        "conditions.sourced",
        "conditions.approved"
      ]
    },
    {
      "id": "model",
      "name": "施工用のモデル",
      "purpose": "設計のモデルを、建てる・吊る・運ぶ単位（施工単位）に分け、重さと材料を持たせる。設計の形と、施工の単位の形の違いを書く。",
      "after": [
        "conditions"
      ],
      "deliverables": [
        "construction-model"
      ],
      "acceptance": [
        "model.complete",
        "model.traced",
        "model.approved"
      ]
    },
    {
      "id": "method",
      "name": "施工方法の選定",
      "purpose": "施工単位ごとの建て方（据え付け・引き上げ・型枠の上昇・仮設の支えなど）を、比べた案と理由とともに決める。",
      "after": [
        "model"
      ],
      "deliverables": [
        "method-statement"
      ],
      "acceptance": [
        "method.complete",
        "method.traced",
        "method.approved"
      ]
    },
    {
      "id": "schedule",
      "name": "工程計画",
      "purpose": "施工単位を建てる作業と節目を、順序・日数・暦で並べ、工期の条件を満たすかを確かめる。実績が出たら実績の日付を書き足す。",
      "after": [
        "method"
      ],
      "deliverables": [
        "master-schedule"
      ],
      "acceptance": [
        "schedule.complete",
        "schedule.traced",
        "schedule.approved"
      ]
    },
    {
      "id": "logistics",
      "name": "揚重・搬入・仮設の計画",
      "purpose": "揚重機（据え付け・昇り・解体を含む）、搬入と人の経路、仮設物と作業の時間を、工程の日付に結びつけて決める。",
      "after": [
        "schedule"
      ],
      "deliverables": [
        "site-logistics-plan"
      ],
      "acceptance": [
        "logistics.complete",
        "logistics.traced",
        "logistics.approved"
      ]
    },
    {
      "id": "simulation",
      "name": "施工の模擬",
      "purpose": "工程と揚重・搬入の計画を日付ごとの模型で動かし、届かない・重すぎる・ぶつかる・支えの無い・時間に収まらない吊りや便を一覧にして、直すか受け入れるかを決める。",
      "after": [
        "logistics"
      ],
      "deliverables": [
        "simulation-record"
      ],
      "acceptance": [
        "simulation.complete",
        "simulation.traced",
        "simulation.approved"
      ]
    },
    {
      "id": "safety",
      "name": "安全の確認",
      "purpose": "吊り荷の下・旋回の範囲・開口や掘削の縁・車の経路など、日付と時刻ごとの危険と、人と車の近づきを一覧にし、対策を決める。",
      "after": [
        "logistics"
      ],
      "deliverables": [
        "hazard-review"
      ],
      "acceptance": [
        "safety.complete",
        "safety.traced",
        "safety.approved"
      ]
    },
    {
      "id": "structure",
      "name": "施工中の構造の確認",
      "purpose": "途中の段階の構造（据え付けた部材・仮設の支え・揚重機の載る所）が、その日の重さに耐えるかを、段階ごとの解析で確かめる。",
      "after": [
        "logistics"
      ],
      "deliverables": [
        "staging-analysis"
      ],
      "acceptance": [
        "structure.complete",
        "structure.traced",
        "structure.approved"
      ]
    },
    {
      "id": "approval",
      "name": "計画の承認",
      "purpose": "模擬・安全・構造で出た事項ごとに、直した・受け入れた・持ち越したを決め、計画の版を承認する。",
      "after": [
        "simulation",
        "safety",
        "structure"
      ],
      "deliverables": [
        "plan-approval"
      ],
      "acceptance": [
        "approval.complete",
        "approval.traced",
        "approval.approved"
      ]
    },
    {
      "id": "presentation",
      "name": "説明と記録",
      "purpose": "承認した版の計画を、関係者が見て分かる形（日付を追う映像・図・説明）にし、公開してよい範囲と出典・注意書きを確かめる。",
      "after": [
        "approval"
      ],
      "deliverables": [
        "presentation-record"
      ],
      "acceptance": [
        "presentation.complete",
        "presentation.traced",
        "presentation.approved"
      ]
    }
  ],
  "sections": [
    {
      "id": "plan",
      "name": "企画",
      "phases": [
        "process",
        "conditions"
      ]
    },
    {
      "id": "design",
      "name": "計画",
      "phases": [
        "model",
        "method",
        "schedule",
        "logistics"
      ]
    },
    {
      "id": "verify",
      "name": "検証",
      "phases": [
        "simulation",
        "safety",
        "structure"
      ]
    },
    {
      "id": "decide",
      "name": "判断と伝達",
      "phases": [
        "approval",
        "presentation"
      ]
    }
  ],
  "deliverables": [
    {
      "id": "process-map",
      "name": "進め方",
      "form": "図",
      "outline": [
        {
          "heading": "対象と出口",
          "describe": "建てるもの、計画の範囲（どこからどこまで）、完成とする状態"
        },
        {
          "heading": "工程と成果物",
          "describe": "使う工程、省く工程と理由、代わりの確認、繰り返す工程"
        },
        {
          "heading": "責任とAIの関与",
          "describe": "承認する人、AIに任せる作業と、人が判断すること"
        },
        {
          "heading": "公開と権利",
          "describe": "題材が実在するときの名乗り方、使う情報の出典、関係者でないことの断り"
        }
      ],
      "uses": []
    },
    {
      "id": "site-conditions",
      "name": "与条件",
      "form": "文書",
      "outline": [
        {
          "heading": "対象",
          "describe": "建てるものの形・高さ・構造の形式・主な材料"
        },
        {
          "heading": "条件",
          "describe": "工期・敷地と周辺・道路・法令・近隣との約束・設計の制約を一件ずつ。出典と確からしさ（確か・推定・仮定）を書く",
          "item": "constraint"
        },
        {
          "heading": "確かでないこと",
          "describe": "分からない・公開されていない情報と、計画での仮定"
        }
      ],
      "uses": [
        "process-map"
      ]
    },
    {
      "id": "construction-model",
      "name": "施工用のモデル",
      "form": "建物",
      "outline": [
        {
          "heading": "施工単位",
          "describe": "建てる・吊る・運ぶ単位ごとに、含む部材、重さ、大きさ、材料。設計の部材との対応",
          "item": "work-unit"
        },
        {
          "heading": "設計との違い",
          "describe": "施工の都合で分けた・まとめた所と、近似した形"
        },
        {
          "heading": "モデルの版",
          "describe": "元にした設計のモデルの版と、施工用のモデルの版"
        }
      ],
      "uses": [
        "site-conditions"
      ]
    },
    {
      "id": "method-statement",
      "name": "施工方法",
      "form": "文書",
      "outline": [
        {
          "heading": "工法",
          "describe": "施工単位ごとの建て方、使う機械と仮設、順序の決まり",
          "item": "method"
        },
        {
          "heading": "比べた案",
          "describe": "採らなかった工法と、比べた観点"
        },
        {
          "heading": "決めた理由",
          "describe": "条件と施工単位から、その工法にした理由"
        }
      ],
      "uses": [
        "site-conditions",
        "construction-model"
      ]
    },
    {
      "id": "master-schedule",
      "name": "工程表",
      "form": "表",
      "outline": [
        {
          "heading": "作業",
          "describe": "施工単位を建てる・撤去する・仮設する・引き上げる作業。先行の作業・日数・始まりと終わり・実績",
          "item": "task"
        },
        {
          "heading": "節目",
          "describe": "工期の条件に結びつく日付（着工・上棟・完成など）と、計画の日付",
          "item": "milestone"
        },
        {
          "heading": "暦",
          "describe": "稼働する曜日・休日・作業の時間"
        }
      ],
      "uses": [
        "method-statement",
        "construction-model"
      ],
      "view": [
        {
          "as": "timeline",
          "items": "task",
          "start": "start",
          "end": "finish",
          "scale": "month"
        },
        {
          "as": "table",
          "items": "milestone",
          "columns": [
            "name",
            "date",
            "planned"
          ]
        }
      ]
    },
    {
      "id": "site-logistics-plan",
      "name": "揚重・搬入・仮設の計画",
      "form": "表",
      "outline": [
        {
          "heading": "揚重機",
          "describe": "種類・据える所・届く範囲と定格荷重・立てる作業と解体の作業・昇りと下がりの日付と高さ・載る部材",
          "item": "equipment"
        },
        {
          "heading": "経路",
          "describe": "搬入の車と人の経路・速さ・時刻または吊りから決まる便・通るゲート",
          "item": "route"
        },
        {
          "heading": "仮設物",
          "describe": "囲い・ゲート・置き場・事務所・支え。立つ期間",
          "item": "temporary"
        },
        {
          "heading": "吊りの割り当て",
          "describe": "施工単位ごとに、吊る揚重機・吊り上げる所・運び込む経路"
        }
      ],
      "uses": [
        "master-schedule",
        "method-statement",
        "construction-model"
      ]
    },
    {
      "id": "simulation-record",
      "name": "施工の模擬の記録",
      "form": "表",
      "outline": [
        {
          "heading": "模擬の条件",
          "describe": "モデル・工程・計画の版、日付の範囲、検査の種類、かかった時間"
        },
        {
          "heading": "事項",
          "describe": "検査で出た事項ごとに、種類・日付・対象・内容・処置（直した・受け入れた・持ち越した）",
          "item": "sim-issue"
        },
        {
          "heading": "映像と画像",
          "describe": "日付を追って見た記録の場所と版"
        }
      ],
      "uses": [
        "site-logistics-plan",
        "master-schedule",
        "construction-model"
      ],
      "view": {
        "as": "table",
        "items": "sim-issue",
        "columns": [
          "kind",
          "day",
          "text",
          "action"
        ],
        "groupBy": "kind"
      }
    },
    {
      "id": "hazard-review",
      "name": "安全の確認",
      "form": "表",
      "outline": [
        {
          "heading": "危険",
          "describe": "日付と時刻の範囲、場所、種類（吊り荷の下・旋回の範囲・縁・車の経路など）、近づく人と車、対策",
          "item": "hazard"
        },
        {
          "heading": "出入りの数",
          "describe": "日ごとのゲートを通る車と人の数"
        }
      ],
      "uses": [
        "site-logistics-plan",
        "master-schedule"
      ]
    },
    {
      "id": "staging-analysis",
      "name": "施工中の構造の確認",
      "form": "文書",
      "outline": [
        {
          "heading": "解析の場合",
          "describe": "段階（日付）、立っている部材と仮設の支え、載せた重さ、結果と完成時との比べ",
          "item": "analysis-case"
        },
        {
          "heading": "解析の条件",
          "describe": "道具・要素・材料・支えの仮定と、その確からしさ"
        }
      ],
      "uses": [
        "master-schedule",
        "site-logistics-plan",
        "construction-model"
      ]
    },
    {
      "id": "plan-approval",
      "name": "計画の承認",
      "form": "文書",
      "outline": [
        {
          "heading": "判断",
          "describe": "事項ごとの処置と理由、残る危険、決めた人",
          "item": "decision"
        },
        {
          "heading": "承認した版",
          "describe": "承認したモデル・工程・計画の版と日付"
        }
      ],
      "uses": [
        "simulation-record",
        "hazard-review",
        "staging-analysis"
      ]
    },
    {
      "id": "presentation-record",
      "name": "説明と記録",
      "form": "文書",
      "outline": [
        {
          "heading": "場面",
          "describe": "映像や説明の場面ごとに、見せる日付・節目・見どころ・使った版",
          "item": "presentation-scene"
        },
        {
          "heading": "注意書きと出典",
          "describe": "近似であること、出典、関係者でないこと、公開してよい範囲"
        },
        {
          "heading": "成果物の場所",
          "describe": "映像・画像・説明の資料の場所と版"
        }
      ],
      "uses": [
        "plan-approval",
        "master-schedule"
      ]
    }
  ],
  "items": [
    {
      "id": "constraint",
      "name": "条件",
      "idForm": "CO-{nn}"
    },
    {
