    },
    {
      "id": "temporary",
      "name": "仮設物",
      "idForm": "TW-{nn}"
    },
    {
      "id": "sim-issue",
      "name": "模擬の事項",
      "idForm": "SI-{nnn}"
    },
    {
      "id": "hazard",
      "name": "危険",
      "idForm": "HZ-{nn}"
    },
    {
      "id": "analysis-case",
      "name": "解析の場合",
      "idForm": "AC-{nn}"
    },
    {
      "id": "decision",
      "name": "判断",
      "idForm": "DC-{nn}"
    },
    {
      "id": "presentation-scene",
      "name": "説明の場面",
      "idForm": "PS-{nn}"
    }
  ],
