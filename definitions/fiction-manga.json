{
  "format": 1,
  "id": "fiction-manga",
  "version": "1.1.0",
  "title": "漫画の制作",
  "purpose": "漫画を、企画と画作りの決まりから、人物・世界と舞台・筋・脚本の設計、ネーム、ラフ・線画・仕上げと写植、通読を経て出版準備まで、作者が工程ごとに成果物を確かめて受け入れながら、AI の提案を採否して作る。",
  "phases": [
    {
      "id": "process",
      "name": "進め方",
      "purpose": "この作品で通る工程と省く工程、工程ごとの成果物と確かめる人、AI に頼むことの範囲、作品の出口を決める。",
      "after": [],
      "deliverables": [
        "process-map"
      ],
      "acceptance": [
        "process.complete",
        "process.ai-scope",
        "process.approved"
      ]
    },
    {
      "id": "concept",
      "name": "企画",
      "purpose": "何を誰に向けて描くか、読後に何を残すか、どの長さでどこへ出すかを決め、絵の決まり・レイヤーの決まり・採用見本をまとめた画作りガイドを作る。",
      "after": [
        "process"
      ],
      "deliverables": [
        "concept-doc",
        "art-guide"
      ],
      "acceptance": [
        "concept.complete",
        "concept.approved",
        "art.layers-defined",
        "art.samples-sourced",
        "art.approved"
      ]
    },
    {
      "id": "character",
      "name": "人物",
      "purpose": "人物の欲求・傷・口調・変えない外見と、人物どうしの関係を決め、人物の設定画を描く。",
      "after": [
        "concept"
      ],
      "deliverables": [
        "character-sheet",
        "relationship-map",
        "character-art"
      ],
      "acceptance": [
        "character.complete",
        "character.art-covered",
        "character.approved",
        "character.art-approved"
      ]
    },
    {
      "id": "stage",
      "name": "世界と舞台",
      "purpose": "物語の世界の決まりと世界線、場所の配置・向き・縮尺を地図に、場所の見え方を舞台の設定画に、固有名詞とその表記を辞書に決める。",
      "after": [
        "concept"
      ],
      "deliverables": [
        "stage-notes",
        "stage-map",
        "stage-art",
        "stage-model",
        "term-dictionary"
      ],
      "acceptance": [
        "stage.map-traced",
        "stage.art-covered",
        "stage.terms-unique",
        "stage.approved",
        "stage.map-approved",
        "stage.art-approved"
      ]
    },
    {
      "id": "story",
      "name": "筋と構成",
      "purpose": "筋・出来事・伏線を置き、出来事の作中の時刻と人物ごとの経験の順を決め、構成の型と山場の配置、話の区切りを決める。読者への提示順は、シーンができてから構成図の提示位置で決める。",
      "after": [
        "character",
        "stage"
      ],
      "deliverables": [
        "story-ledger",
        "structure-map"
      ],
      "acceptance": [
        "story.threads-themed",
        "story.foreshadowing-traced",
        "story.approved"
      ]
    },
    {
      "id": "script",
      "name": "脚本",
      "purpose": "シーンごとに目的・視点・葛藤・変化・登場人物・場所と台詞を書き、構成図の提示位置に並べて話へ割り当てる。",
      "after": [
        "story"
      ],
      "deliverables": [
        "script-doc"
      ],
      "acceptance": [
        "script.traced",
        "script.threads-covered",
        "script.occurrences-traced",
        "script.speakers",
        "script.approved"
      ]
    },
    {
      "id": "storyboard",
      "name": "ネーム",
      "purpose": "ページとコマを割り、コマごとに人物の配置とカメラの位置を舞台の上で決め、場所・台詞・間を決める。",
      "after": [
        "script"
      ],
      "deliverables": [
        "storyboard-pages"
      ],
      "acceptance": [
        "storyboard.traced",
        "storyboard.scenes-covered",
        "storyboard.figures-posed",
        "storyboard.reading-direction",
        "storyboard.approved"
      ]
    },
    {
      "id": "rough",
      "name": "ラフ",
      "purpose": "ネームのページごとに、構図・ポーズ・接触・背景の位置をラフに描き、もとにする設定画・見本と作画の方法を決める。",
      "after": [
        "storyboard"
      ],
      "deliverables": [
        "rough-pages"
      ],
      "acceptance": [
        "rough.layers",
        "rough.sources",
        "rough.figures-drawn",
        "rough.approved"
      ]
    },
    {
      "id": "ink",
      "name": "線画",
      "purpose": "ラフのページごとに線画を描く。",
      "after": [
        "rough"
      ],
      "deliverables": [
        "ink-pages"
      ],
      "acceptance": [
        "ink.layers",
        "ink.approved"
      ]
    },
    {
      "id": "finish",
      "name": "仕上げと写植",
      "purpose": "線画のページごとにトーン・塗り・影・効果を仕上げ、吹き出しと文字を入れる。",
      "after": [
        "ink"
      ],
      "deliverables": [
        "finished-pages",
        "lettering-record"
      ],
      "acceptance": [
        "finish.layers",
        "finish.generated-sourced",
        "lettering.traced",
        "lettering.covered",
        "finish.approved",
        "lettering.approved"
      ]
    },
    {
      "id": "read",
      "name": "通読",
      "purpose": "固定した版を通して読み、指摘ごとに直すかを決め、作品の完成を判断する。",
      "after": [
        "finish"
      ],
      "deliverables": [
        "editorial-record"
      ],
      "acceptance": [
        "read.fixed-version",
        "read.traced",
        "read.approved"
      ]
    },
    {
      "id": "output",
      "name": "出版準備",
      "purpose": "出口に合わせた形式で出力し、書誌情報と紹介文、AI の関わりの記録をそろえる。",
      "after": [
        "read"
      ],
      "deliverables": [
        "output-record"
      ],
      "acceptance": [
        "output.from-fixed",
        "output.approved"
      ]
    },
    {
      "id": "learning",
      "name": "学び",
      "purpose": "この作品で得たことのうち、次の作品で変えることを選んで残す。",
      "after": [
        "output"
      ],
      "deliverables": [
        "learning-record"
      ],
      "acceptance": [
        "learning.chosen"
      ]
    }
  ],
  "sections": [
    {
      "id": "plan",
      "name": "企画",
      "phases": [
        "process",
        "concept"
      ]
    },
    {
      "id": "design",
      "name": "物語設計",
      "phases": [
        "character",
        "stage",
        "story",
        "script"
      ]
    },
    {
      "id": "draw",
      "name": "ネームと作画",
      "phases": [
        "storyboard",
        "rough",
        "ink",
        "finish"
      ]
    },
    {
      "id": "finish-and-publish",
      "name": "仕上げと公開",
      "phases": [
        "read",
        "output",
        "learning"
      ]
    }
  ],
  "deliverables": [
    {
      "id": "process-map",
      "name": "進め方",
      "form": "図",
      "outline": [
        {
          "heading": "工程の順",
          "describe": "通る工程と、その順とつながり"
        },
        {
          "heading": "工程ごとの成果物と確かめる人",
          "describe": "工程ごとに、作る成果物・達成条件・確かめる人"
        },
        {
          "heading": "省く工程",
          "describe": "省く工程と省く成果物（舞台の3Dモデルなど）と、その理由と代わりの確かめ方"
        },
        {
          "heading": "AI に頼むこと",
          "describe": "作品全体の既定として、AI に絵や台詞を描かせるか、提案だけか、読むだけかの範囲を工程ごとに。話やページごとに変えてよいかと、その決め方。AI に絵を生成させるときは、使う道具と、生成を断られた・失敗したときの代わり（指示を変える・人が描く・その絵を省く）"
        },
        {
          "heading": "出口",
          "describe": "描き上げた作品をどこに出すか（投稿・公募・連載・同人・私家版など）と、その規定"
        }
      ]
    },
    {
      "id": "concept-doc",
      "name": "企画書",
      "form": "文書",
      "outline": [
        {
          "heading": "ログライン",
          "describe": "作品を一文で言うと何か"
        },
        {
          "heading": "テーマ",
          "describe": "作品が扱う問いと、読後に残したいもの",
          "item": "theme"
        },
        {
          "heading": "読者",
          "describe": "想定する読者と、その読者が作品に求めるもの"
        },
        {
          "heading": "長さ",
          "describe": "目標のページ数と話の数の目安"
        },
        {
          "heading": "結末までのあらすじ",
          "describe": "始まりから結末までの流れ。結末を伏せずに書く"
        },
        {
          "heading": "出口と規定",
          "describe": "出す先の規定（ページ数・判型・原稿の形式・AI の利用の申告など）"
        }
      ]
    },
    {
      "id": "art-guide",
      "name": "画作りガイド",
      "form": "文書",
      "outline": [
        {
          "heading": "画作りの決まり",
          "describe": "線・形の誇張・配色・陰影・密度・カメラと演出・人物の固定した外見・許す例外など、守る決まり",
          "item": "art-rule"
        },
        {
          "heading": "レイヤーの決まり",
          "describe": "レイヤーごとに、名前・重ね順・描く中身（下描き・線画・塗り・影・背景・効果・吹き出し・文字など）・使う段階（設定画・ラフ・線画・仕上げ）・分けたまま残すか、まとめてよいか・人と AI のどちらが描いてよいか。段階ごとに要るレイヤーと、ラフから線画・仕上げへ引き継ぐレイヤーも書く",
          "item": "layer"
        },
        {
          "heading": "採用見本",
          "describe": "見本ごとに、何の見本か・出典・利用条件・外へ送ってよいか・固定した版",
          "item": "sample"
        },
        {
          "heading": "文字の決まり",
          "describe": "台詞・擬音・手書き文字の書体と大きさ、縦書き・横書き、ルビの決まり。ページとコマを読む方向（右から左か左から右か）"
        }
      ],
      "uses": [
        "concept-doc"
      ]
    },
    {
      "id": "character-sheet",
      "name": "人物表",
      "form": "表",
      "outline": [
        {
          "heading": "人物",
          "describe": "人物ごとに、欲求・傷・口調・他の人物との関係・初めて出る場面・変えない外見",
          "item": "character"
        }
      ],
      "uses": [
        "concept-doc"
      ]
    },
    {
      "id": "relationship-map",
      "name": "相関図",
      "form": "図",
      "outline": [
        {
          "heading": "関係",
          "describe": "人物どうしの関係と、その関係が物語の中でどう変わるか"
        }
      ],
      "uses": [
        "character-sheet"
      ]
    },
    {
      "id": "character-art",
      "name": "人物の設定画",
      "form": "図",
      "outline": [
        {
          "heading": "人物ごとの設定画",
          "describe": "人物（CH）ごとに、正面・側面・背面・表情・衣装・持ち物。主要な人物どうしは髪型・体格・シルエットで見分けられるようにする。双子や正体を隠す人物のように意図して似せるときは、その設定と演出上の扱いを書く。時期や世界で外見が変わるときは、変わる前と後を分けて描く"
        },
        {
          "heading": "レイヤー",
          "describe": "設定画ごとに、使ったレイヤーを画作りガイドのレイヤーの決まりの名前で書く。決まりに無いレイヤーを足したときと、決まりで分けておくレイヤーをまとめたときは、その理由。人が描いた・直したレイヤーと、AI の提案を採ったレイヤー。AI が生成した画像を採ったレイヤーには、生成に使った道具と版・渡した参照（設定画・ネーム・採用見本の固定した版）・出典と利用条件"
        }
      ],
      "uses": [
        "character-sheet",
        "art-guide"
      ]
    },
    {
      "id": "stage-notes",
      "name": "世界の覚え書き",
      "form": "文書",
      "outline": [
        {
          "heading": "世界の決まり",
          "describe": "物語の世界で成り立つこと・成り立たないこと"
        },
        {
          "heading": "世界線と時計",
          "describe": "作品の中の世界ごとに、親の世界（一つだけ）と、親から受け継ぐ出来事の集合とその固定した版、分岐を見せる時点、使う時計。時計ごとに、原点と、別の時計との整数日の差"
        },
        {
          "heading": "世界間の移送",
          "describe": "人物や物が世界をまたぐごとに、どの個体が、どの出来事で、どの世界からどの世界へ移るか。時刻の計算とは別に書く"
        }
      ],
      "uses": [
        "concept-doc"
      ]
    },
    {
      "id": "stage-map",
      "name": "地図",
      "form": "図",
      "outline": [
        {
          "heading": "場所",
          "describe": "場所ごとに、様子・位置・向き・縮尺・そこで起きうること。時点や世界線で様子が変わる場所は、変わる前と後を分けて書き、どの出来事で変わるかを書く",
          "item": "location"
        },
        {
          "heading": "道",
          "describe": "場所と場所のつながりごとに、道のりと、移動にかかる時間の目安",
          "item": "route"
        }
      ],
      "uses": [
        "stage-notes"
      ],
      "view": {
        "as": "graph",
        "nodes": [
          "location"
        ],
        "edges": [
          "route"
        ]
      }
    },
    {
      "id": "stage-art",
      "name": "舞台の設定画",
      "form": "図",
      "outline": [
        {
          "heading": "場所ごとの設定画",
          "describe": "場所（LO）ごとに、全景・主な向きからの見え方・時代と建築・明るさ。地図と同じ向きと縮尺で描く"
        },
        {
          "heading": "レイヤー",
          "describe": "設定画ごとに、使ったレイヤーを画作りガイドのレイヤーの決まりの名前で書く。決まりに無いレイヤーを足したときと、決まりで分けておくレイヤーをまとめたときは、その理由。人が描いた・直したレイヤーと、AI の提案を採ったレイヤー。AI が生成した画像を採ったレイヤーには、生成に使った道具と版・渡した参照（設定画・ネーム・採用見本の固定した版）・出典と利用条件"
        }
      ],
      "uses": [
        "stage-map",
        "art-guide"
      ]
    },
    {
      "id": "stage-model",
      "name": "舞台の3Dモデル",
      "form": "3Dモデル",
      "outline": [
        {
          "heading": "場所ごとの3Dモデル",
          "describe": "場所（LO）ごとの、地図と同じ向きと縮尺の 3D モデル。ネームで人物とカメラを置き、ラフの下絵に使う。作らない作品では、進め方で省くと決めて空にしてよい"
        },
        {
          "heading": "使う資料",
          "describe": "場所ごとに、もとにした地図と舞台の設定画の固定した版"
        }
      ],
      "uses": [
        "stage-map",
        "stage-art"
      ]
    },
    {
      "id": "term-dictionary",
      "name": "固有名詞と表記の辞書",
      "form": "表",
      "outline": [
        {
          "heading": "用語",
          "describe": "用語ごとに、正しい表記・読み・ルビの有無・使わない表記",
          "item": "term"
        }
      ],
      "uses": [
        "stage-notes",
        "character-sheet"
      ]
    },
    {
      "id": "story-ledger",
      "name": "筋の台帳",
      "form": "表",
      "outline": [
        {
          "heading": "筋",
          "describe": "物語を貫く筋ごとに、始まり・転機・決着",
          "item": "plot-thread"
        },
        {
          "heading": "出来事",
          "describe": "出来事ごとに、作中の時刻（未定・日・期間・幅、ほかの出来事からの日数）と、関わる人物の個体と場所、誰が何を知り・信じ・言ったか。シーンが無い出来事も書いてよい。読者への提示順はここに書かない",
          "item": "event"
        },
        {
          "heading": "伏線",
          "describe": "伏線ごとに、張る場所・回収する場所。回収しないときは理由（次の話への持ち越し・意図したミスリードなど）",
          "item": "foreshadowing"
        }
      ],
      "uses": [
        "concept-doc",
        "character-sheet",
        "stage-notes",
        "stage-map"
      ]
    },
    {
      "id": "structure-map",
      "name": "構成図",
      "form": "図",
      "outline": [
        {
          "heading": "構成の型",
          "describe": "選んだ構成の型（起承転結・三幕・序破急・独自など）と、話の区切り"
        },
        {
          "heading": "山場の配置",
          "describe": "山場と転機を、全体と話のどこに置くか"
        },
        {
          "heading": "提示位置",
          "describe": "作品の中でシーンを読者に示す一回ごとに、示すシーン（固定した版）・並び・話。同じシーンをもう一度示すときは提示位置を別に作る。読者への提示順はここだけに書く",
          "item": "occurrence"
        },
        {
          "heading": "人物の経験の順",
          "describe": "人物の個体ごとに、本人が経験する出来事の順。作中の時刻や提示順とは別に書く"
        }
      ],
      "uses": [
        "story-ledger"
      ]
    },
    {
      "id": "script-doc",
      "name": "脚本",
      "form": "文書",
      "outline": [
        {
          "heading": "シーン",
          "describe": "シーンごとに、目的・視点人物・葛藤・変化・登場人物・場所と、描く出来事（固定した版）。番号は話に依らず作品の中で固定し、使い回さない",
          "item": "scene",
          "children": [
            {
              "heading": "台詞",
              "describe": "台詞ごとに、話す人物・言い方・心の声か声か。ト書きは台詞と分けて書く",
              "item": "dialogue"
            }
          ]
        }
      ],
      "uses": [
        "story-ledger",
        "structure-map",
        "character-sheet",
        "term-dictionary"
      ]
    },
    {
      "id": "storyboard-pages",
      "name": "ネーム",
      "form": "図",
      "outline": [
        {
          "heading": "ページ",
          "describe": "ページごとに、見開きか片ページか、めくりの位置。番号は作品の中で固定し、使い回さない",
          "item": "page"
        },
        {
          "heading": "コマ",
          "describe": "コマごとに、入るページ・枠の形と大きさ・読む順・描く場所・入れる台詞・間と、カメラの位置・向き・画角（舞台の3Dモデルか地図の上で）。コマはページを ID の親にしない。別のページへ移しても ID を保つ",
          "item": "panel",
          "children": [
            {
              "heading": "人物の配置",
              "describe": "コマに描く人物ごとに、どの人物か・舞台のどこ（3D モデルか地図の上の位置）にいるか・向き・姿勢。コマの上に、そのコマで描写する範囲のアタリ（頭の向きが分かる十字・胴・関節の分かる腕と脚の簡単な形と、見えるときは目と口）を描き、描写する範囲の向き・姿勢と要る表情が読めるようにする。顔のアップ・後ろ姿・手元だけ・シルエットのように、画角の外・隠れる・意図して描かない部分は描かず、その構図か省いた理由を書く。アタリの名前に、どの人物の配置（FG）か・ポーズの意図を書く",
              "item": "figure"
            }
          ]
        }
      ],
      "uses": [
        "script-doc",
        "character-art",
        "stage-art",
        "stage-map",
        "stage-model"
      ],
      "view": {
        "as": "graph",
