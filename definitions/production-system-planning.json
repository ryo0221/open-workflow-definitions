{
  "format": 1,
  "id": "production-system-planning",
  "version": "1.0.0",
  "title": "生産システム計画",
  "purpose": "工場の生産ラインを、製品と量の要件から、作業・設備・バッファ・搬送・作業者・配置として計画し、そのラインを時刻で動くモデルにして流し、生産数・稼働の内訳・ボトルネックを確かめ、改善の案を比べて採り、承認を経て関係者に説明できる形にする。題材・手法・道具・出力形式は利用側が決める。",
  "phases": [
    {
      "id": "process",
      "name": "進め方",
      "purpose": "対象と範囲、工程、省略・反復の扱い、AIに委ねる範囲、承認責任者と完成の出口を決める。",
      "after": [],
      "deliverables": [
        "process-map"
      ],
      "acceptance": [
        "process.complete",
        "process.approved"
      ]
    },
    {
      "id": "requirements",
      "name": "生産の要件",
      "purpose": "作る製品と量、品種の混ざり方、タクト、稼働の時間、品質、建屋・予算・人の制約を、ラインが満たす要件として一件ずつ書く。",
      "after": [
        "process"
      ],
      "deliverables": [
        "production-requirements"
      ],
      "acceptance": [
        "requirements.complete",
        "requirements.sourced",
        "requirements.approved"
      ]
    },
    {
      "id": "process-design",
      "name": "工程の設計",
      "purpose": "製品の種類ごとに、部品の構成と、加工・組付け・検査・梱包の作業の順と作業時間を決める。",
      "after": [
        "requirements"
      ],
      "deliverables": [
        "process-plan"
      ],
      "acceptance": [
        "process-design.complete",
        "process-design.traced",
        "process-design.approved"
      ]
    },
    {
      "id": "line-design",
      "name": "ラインの設計",
      "purpose": "作業を受け持つ設備と、そのあいだのバッファ・搬送・作業者・シフトを決め、物の流れのつながりをモデルにする。",
      "after": [
        "process-design"
      ],
      "deliverables": [
        "line-model"
      ],
      "acceptance": [
        "line-design.complete",
        "line-design.traced",
        "line-design.approved"
      ]
    },
    {
      "id": "data",
      "name": "入力のデータ",
      "purpose": "作業時間・故障と修理・段取り・投入の計画などの値と分布を、出典と確からしさとともに集めて、モデルの資源に結びつける。",
      "after": [
        "line-design"
      ],
      "deliverables": [
        "input-data"
      ],
      "acceptance": [
        "data.complete",
        "data.traced",
        "data.approved"
      ]
    },
    {
      "id": "layout",
      "name": "配置の計画",
      "purpose": "設備・バッファ・通路・置き場を建屋の中に置き、柱・壁・通路との干渉と、人と搬送の動線を確かめる。",
      "after": [
        "line-design"
      ],
      "deliverables": [
        "layout-plan"
      ],
      "acceptance": [
        "layout.complete",
        "layout.traced",
        "layout.approved"
      ]
    },
    {
      "id": "validation",
      "name": "モデルの妥当性の確認",
      "purpose": "モデルが意図どおりに動くか（検証）と、現実のラインや手計算と合うか（妥当性の確認）を、比べた値と差とともに確かめる。",
      "after": [
        "data"
      ],
      "deliverables": [
        "validation-record"
      ],
      "acceptance": [
        "validation.complete",
        "validation.traced",
        "validation.approved"
      ]
    },
    {
      "id": "experiment",
      "name": "実験と比較",
      "purpose": "現状と改善の案を、同じ条件で繰り返し流して、生産数・稼働の内訳・ボトルネック・仕掛り・リードタイムを、ばらつきとともに比べる。",
      "after": [
        "validation"
      ],
      "deliverables": [
        "experiment-record"
      ],
      "acceptance": [
        "experiment.complete",
        "experiment.sound",
        "experiment.traced",
        "experiment.approved"
      ]
    },
    {
      "id": "control",
      "name": "制御の確認",
      "purpose": "設備と搬送の制御（センサーと動作のつながり、止める・出すの条件）をモデルにつないで動かし、制御の誤りが流れに出ないかを確かめる。",
      "after": [
        "validation"
      ],
      "deliverables": [
        "control-record"
      ],
      "acceptance": [
        "control.complete",
        "control.traced",
        "control.approved"
      ]
    },
    {
      "id": "approval",
      "name": "計画の承認",
      "purpose": "配置・妥当性・実験・制御で出た事項ごとに、直した・受け入れた・持ち越したを決め、採る案とラインの計画の版を承認する。",
      "after": [
        "experiment",
        "control",
        "layout"
      ],
      "deliverables": [
        "plan-approval"
      ],
      "acceptance": [
        "approval.complete",
        "approval.traced",
        "approval.approved"
      ]
    },
    {
      "id": "presentation",
      "name": "説明と記録",
      "purpose": "承認した版の計画を、関係者が見て分かる形（時刻を追う映像・図・比べの表・説明）にし、公開してよい範囲と出典・注意書きを確かめる。",
      "after": [
        "approval"
      ],
      "deliverables": [
        "presentation-record"
      ],
      "acceptance": [
        "presentation.complete",
        "presentation.traced",
        "presentation.approved"
      ]
    }
  ],
  "sections": [
    {
      "id": "plan",
      "name": "企画",
      "phases": [
        "process",
        "requirements"
      ]
    },
    {
      "id": "design",
      "name": "計画",
      "phases": [
        "process-design",
        "line-design",
        "data",
        "layout"
      ]
    },
    {
      "id": "verify",
      "name": "検証",
      "phases": [
        "validation",
        "experiment",
        "control"
      ]
    },
    {
      "id": "decide",
      "name": "判断と伝達",
      "phases": [
        "approval",
        "presentation"
      ]
    }
  ],
  "deliverables": [
    {
      "id": "process-map",
      "name": "進め方",
      "form": "図",
      "outline": [
        {
          "heading": "対象と出口",
          "describe": "計画するライン（または工場）、計画の範囲（どこからどこまで）、完成とする状態"
        },
        {
          "heading": "工程と成果物",
          "describe": "使う工程、省く工程と理由、代わりの確認、繰り返す工程"
        },
        {
          "heading": "責任とAIの関与",
          "describe": "承認する人、AIに任せる作業と、人が判断すること"
        },
        {
          "heading": "公開と権利",
          "describe": "題材が実在するときの名乗り方、使う情報の出典、関係者でないことの断り、参考にした手法と製品名の扱い"
        }
      ],
      "uses": []
    },
    {
      "id": "production-requirements",
      "name": "生産の要件",
      "form": "文書",
      "outline": [
        {
          "heading": "製品と量",
          "describe": "作る製品の種類、期間あたりの量と品種の混ざり方、タクト"
        },
        {
          "heading": "要件",
          "describe": "量・タクト・稼働の時間・品質・建屋・予算・人の制約を一件ずつ。目標の値、出典と確からしさ（確か・推定・仮定）を書く",
          "item": "requirement"
        },
        {
          "heading": "確かでないこと",
          "describe": "分からない・決まっていない情報と、計画での仮定"
        }
      ],
      "uses": [
        "process-map"
      ]
    },
    {
      "id": "process-plan",
      "name": "工程の設計",
      "form": "表",
      "outline": [
        {
          "heading": "製品の種類",
          "describe": "製品の種類ごとに、部品の構成、混ざる割合、元にした設計の版",
          "item": "product"
        },
        {
          "heading": "作業",
          "describe": "製品の種類ごとの加工・組付け・検査・梱包の作業。先行の作業、作業時間の見込み、要る技能と道具",
          "item": "operation"
        },
        {
          "heading": "工程の経路",
          "describe": "製品の種類ごとに、作業を通る順"
        }
      ],
      "uses": [
        "production-requirements"
      ],
      "view": [
        {
          "as": "table",
          "items": "operation",
          "columns": [
            "name",
            "product",
            "after",
            "time"
          ],
          "groupBy": "product"
        }
      ]
    },
    {
      "id": "line-model",
      "name": "ラインのモデル",
      "form": "図",
      "outline": [
        {
          "heading": "資源",
          "describe": "設備・並列の設備・組立・バッファ・コンベヤ・搬送車・作業者・投入口・出口ごとに、種類、受け持つ作業、容量・速さ・台数・人数、シフト",
          "item": "resource"
        },
        {
          "heading": "つながり",
          "describe": "物が流れる向き（from・to）と、出口が複数のときの振り分けの決まり",
          "item": "connection"
        },
        {
          "heading": "シフトと暦",
          "describe": "稼働する時間・休憩・休日"
        },
        {
          "heading": "モデルの版",
          "describe": "元にした工程の設計の版と、ラインのモデルの版。省いた・まとめた所"
        }
      ],
      "uses": [
        "process-plan",
        "production-requirements"
      ],
      "view": [
        {
          "as": "graph",
          "nodes": [
            "resource"
          ],
          "edges": [
            "connection"
          ],
          "colorBy": "kind"
        },
        {
          "as": "table",
          "items": "resource",
          "columns": [
            "name",
            "kind",
            "capacity"
          ],
          "groupBy": "kind"
        }
      ]
    },
    {
      "id": "input-data",
      "name": "入力のデータ",
      "form": "表",
      "outline": [
        {
          "heading": "データ",
          "describe": "作業時間・故障の間隔と修理の時間・段取りの時間・投入の計画などの値か分布、単位、測った条件、出典と確からしさ（確か・推定・仮定）、当てはめた資源",
          "item": "data-set"
        },
        {
          "heading": "確かでないこと",
          "describe": "足りないデータと、置いた仮定。結果への効き方"
        }
      ],
      "uses": [
        "line-model",
        "process-plan"
      ],
      "view": {
        "as": "table",
        "items": "data-set",
        "columns": [
          "name",
          "kind",
          "distribution",
          "source",
          "certainty"
        ],
        "groupBy": "kind"
      }
    },
    {
      "id": "layout-plan",
      "name": "配置の計画",
      "form": "図",
      "outline": [
        {
          "heading": "区画と通路",
          "describe": "設備の区画・バッファと置き場・人と搬送車の通路の位置と大きさ。置く資源",
          "item": "zone"
        },
        {
          "heading": "建屋",
          "describe": "元にした建屋のモデルの版、柱・壁・開口・床の荷重の条件"
        },
        {
          "heading": "配置の事項",
          "describe": "柱・壁・通路との干渉、狭い所、動線の交わりなどを一件ずつ。処置（直した・受け入れた・持ち越した）",
          "item": "layout-issue"
        }
      ],
      "uses": [
        "line-model",
        "production-requirements"
      ],
      "view": {
        "as": "table",
        "items": "layout-issue",
        "columns": [
          "kind",
          "text",
          "action"
        ],
        "groupBy": "kind"
      }
    },
    {
      "id": "validation-record",
      "name": "モデルの妥当性の確認",
      "form": "表",
      "outline": [
        {
          "heading": "確認",
          "describe": "確認ごとに、種類（動きの確かめ・手計算との比べ・実績との比べ・極端な条件）、条件、期待した値、得た値、差、合否",
          "item": "validation-check"
        },
        {
          "heading": "確認の条件",
          "describe": "モデルと入力のデータの版、乱数の種、流した時間、慣らしの時間"
        }
      ],
      "uses": [
        "line-model",
        "input-data",
        "production-requirements"
      ],
      "view": {
        "as": "table",
        "items": "validation-check",
        "columns": [
          "kind",
          "expected",
          "actual",
          "result"
        ],
        "groupBy": "kind"
      }
    },
    {
      "id": "experiment-record",
      "name": "実験の記録",
      "form": "表",
      "outline": [
        {
          "heading": "案",
          "describe": "現状と改善の案ごとに、モデルから変えた所（バッファの容量、搬送車の台数、作業者の人数、作業時間など）",
          "item": "scenario"
        },
        {
          "heading": "実験の条件",
          "describe": "モデルと入力のデータの版、流した時間、慣らしの時間、繰り返しの数、乱数の種、かかった時間"
        },
        {
          "heading": "所見",
          "describe": "案ごとの生産数・稼働の内訳・ボトルネック・仕掛り・リードタイムを、平均とばらつき（信頼区間など）で。要件との比べ",
          "item": "finding"
        },
        {
          "heading": "映像と画像",
          "describe": "時刻を追って見た記録の場所と版"
        }
      ],
      "uses": [
        "line-model",
        "input-data",
        "validation-record",
        "production-requirements"
      ],
      "view": [
        {
          "as": "table",
          "items": "finding",
          "columns": [
            "scenario",
            "kind",
            "text",
            "value"
          ],
          "groupBy": "scenario"
        },
        {
          "as": "matrix",
          "rows": "finding",
          "columns": "requirement"
        }
      ]
    },
    {
      "id": "control-record",
      "name": "制御の確認",
      "form": "表",
      "outline": [
        {
          "heading": "つなぎ",
          "describe": "センサー（到着・詰まり・満杯など）と動作（動かす・止める・出す）を、どの資源のどの状態につないだか"
        },
        {
          "heading": "確認",
          "describe": "確認ごとに、条件（正しい制御・わざと誤った制御）、期待した流れ、得た流れ、合否",
          "item": "control-case"
        },
        {
          "heading": "確認の条件",
          "describe": "制御の版、走査の周期、モデルの版"
        }
      ],
      "uses": [
        "line-model",
        "validation-record"
      ]
    },
    {
      "id": "plan-approval",
      "name": "計画の承認",
      "form": "文書",
      "outline": [
        {
          "heading": "判断",
          "describe": "事項ごとの処置と理由、採る案、残る危険、決めた人",
          "item": "decision"
        },
        {
          "heading": "承認した版",
          "describe": "承認したモデル・入力のデータ・配置・制御の版と日付"
        }
      ],
      "uses": [
        "experiment-record",
        "validation-record",
        "layout-plan",
        "control-record"
      ]
    },
    {
      "id": "presentation-record",
      "name": "説明と記録",
      "form": "文書",
      "outline": [
        {
          "heading": "場面",
          "describe": "映像や説明の場面ごとに、見せる案・時刻・見どころ・使った版",
          "item": "presentation-scene"
        },
        {
          "heading": "注意書きと出典",
          "describe": "架空か近似であること、出典、関係者でないこと、公開してよい範囲"
        },
        {
          "heading": "成果物の場所",
          "describe": "映像・画像・説明の資料の場所と版"
        }
      ],
      "uses": [
        "plan-approval",
        "experiment-record"
      ]
    }
  ],
  "items": [
    {
      "id": "requirement",
      "name": "要件",
      "idForm": "RQ-{nn}"
    },
    {
      "id": "product",
      "name": "製品の種類",
      "idForm": "PT-{nn}"
    },
    {
      "id": "operation",
      "name": "作業",
      "idForm": "OP-{nnn}"
    },
    {
      "id": "resource",
      "name": "資源",
      "idForm": "RS-{nnn}"
    },
    {
      "id": "connection",
      "name": "つながり",
      "idForm": "CN-{nnn}"
    },
    {
      "id": "data-set",
      "name": "データ",
      "idForm": "DS-{nn}"
    },
    {
      "id": "zone",
      "name": "区画と通路",
      "idForm": "ZN-{nn}"
    },
    {
      "id": "layout-issue",
      "name": "配置の事項",
      "idForm": "LI-{nn}"
    },
    {
      "id": "validation-check",
      "name": "妥当性の確認",
      "idForm": "VC-{nn}"
    },
    {
      "id": "scenario",
      "name": "案",
      "idForm": "SC-{nn}"
    },
    {
      "id": "finding",
      "name": "所見",
      "idForm": "FD-{nnn}"
    },
    {
      "id": "control-case",
      "name": "制御の確認",
      "idForm": "CC-{nn}"
    },
    {
      "id": "decision",
      "name": "判断",
      "idForm": "DC-{nn}"
    },
    {
      "id": "presentation-scene",
      "name": "説明の場面",
      "idForm": "PS-{nn}"
    }
  ],
  "rules": [
    {
      "id": "product-cites-requirement",
      "type": "cites",
      "from": "product",
      "to": [
        "requirement"
      ],
      "min": 1
    },
    {
      "id": "operation-cites-product",
      "type": "cites",
      "from": "operation",
      "to": [
        "product"
      ],
      "min": 1
    },
    {
      "id": "operation-cites-operation",
      "type": "cites",
      "from": "operation",
      "to": [
        "operation"
      ],
      "min": 0
    },
    {
      "id": "resource-cites-operation",
      "type": "cites",
      "from": "resource",
      "to": [
        "operation"
      ],
      "min": 0
    },
    {
      "id": "resource-cites-requirement",
      "type": "cites",
      "from": "resource",
      "to": [
        "requirement"
      ],
      "min": 0
    },
    {
      "id": "connection-cites-resource",
      "type": "cites",
      "from": "connection",
      "to": [
        "resource"
      ],
      "min": 2
    },
    {
      "id": "data-set-cites-model",
      "type": "cites",
      "from": "data-set",
      "to": [
        "resource",
        "operation"
      ],
      "min": 1
    },
    {
      "id": "zone-cites-resource",
      "type": "cites",
      "from": "zone",
      "to": [
        "resource"
      ],
      "min": 0
    },
    {
      "id": "layout-issue-cites-plan",
      "type": "cites",
      "from": "layout-issue",
      "to": [
        "zone",
        "resource"
      ],
      "min": 1
    },
    {
      "id": "validation-check-cites-model",
      "type": "cites",
      "from": "validation-check",
      "to": [
        "resource",
        "data-set",
        "requirement"
      ],
      "min": 1
    },
    {
      "id": "scenario-cites-model",
      "type": "cites",
      "from": "scenario",
      "to": [
        "resource",
        "data-set",
        "connection",
        "zone"
      ],
      "min": 1
    },
    {
      "id": "finding-cites-scenario",
      "type": "cites",
      "from": "finding",
      "to": [
        "scenario"
      ],
      "min": 1
    },
    {
      "id": "finding-cites-requirement",
      "type": "cites",
      "from": "finding",
      "to": [
        "requirement"
      ],
      "min": 0
    },
    {
      "id": "finding-cites-resource",
      "type": "cites",
      "from": "finding",
      "to": [
        "resource"
      ],
      "min": 0
    },
    {
      "id": "control-case-cites-resource",
      "type": "cites",
      "from": "control-case",
      "to": [
        "resource"
      ],
      "min": 1
    },
    {
