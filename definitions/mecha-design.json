    },
    {
      "id": "color",
      "name": "配色",
      "idForm": "CL-{nn}"
    },
    {
      "id": "shot",
      "name": "見せ場",
      "idForm": "SC-{nn}"
    },
    {
      "id": "issue",
      "name": "指摘",
      "idForm": "IS-{nn}"
    },
    {
      "id": "decision",
      "name": "判断",
      "idForm": "DC-{nn}"
    }
  ],
  "rules": [
    {
      "id": "unit-cites-requirement",
      "type": "cites",
      "from": "unit",
      "to": [
        "requirement"
      ],
      "min": 1
    },
    {
      "id": "form-cites-unit",
      "type": "cites",
      "from": "form",
      "to": [
        "unit",
        "form"
      ],
      "min": 1
    },
    {
      "id": "silhouette-cites-form",
      "type": "cites",
      "from": "silhouette",
      "to": [
        "form",
        "requirement"
      ],
      "min": 1
    },
    {
      "id": "proportion-cites-form",
      "type": "cites",
      "from": "proportion",
      "to": [
        "form",
        "silhouette",
        "requirement"
      ],
      "min": 1
    },
    {
      "id": "joint-cites-unit",
      "type": "cites",
      "from": "joint",
      "to": [
        "unit",
        "form"
      ],
      "min": 1
    },
    {
      "id": "step-cites-joint",
      "type": "cites",
      "from": "step",
      "to": [
        "joint",
        "form",
        "step"
      ],
      "min": 1
    },
    {
