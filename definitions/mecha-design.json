    {
      "id": "joint-covered",
      "type": "covered",
      "of": "joint",
      "by": [
        "check",
        "toy-check",
        "step"
      ]
    },
    {
      "id": "issue-covered",
      "type": "covered",
      "of": "issue",
      "by": [
        "decision"
      ]
    }
  ],
  "acceptance": [
    {
      "id": "process.complete",
      "text": "題材と出口、関わる組織と担当、工程ごとの承認の条件、AIの関与、道具、参考と権利が書かれている。",
      "checkedBy": "AI",
      "target": "process-map"
    },
    {
      "id": "process.approved",
      "text": "制作側と玩具側の責任者が、工程・担当・承認の条件を確かめ、開始を承認している。",
      "checkedBy": "人",
      "target": "process-map"
    },
    {
      "id": "brief.complete",
      "text": "役割・見せ場・商品の条件・制約が要求として一件ずつ書かれ、出した人の立場が付いている。",
      "checkedBy": "AI",
      "target": "requirements"
    },
    {
      "id": "brief.approved",
      "text": "監督・ディレクター・玩具の担当が、要求と優先の順を確かめ、承認している。",
      "checkedBy": "人",
      "target": "requirements"
    },
    {
      "id": "concept.complete",
      "text": "機体ごとに役割と形態、合体での部位が書かれ、要求を引いている。",
      "checkedBy": "AI",
      "target": "combine-concept",
      "rules": [
        "unit-cites-requirement",
        "form-cites-unit"
      ]
    },
    {
      "id": "concept.covered",
      "text": "要求が機体・形態・玩具の確認のどれかに引かれているか、引かない理由が書かれている。",
      "checkedBy": "AI",
      "target": "combine-concept",
      "rules": [
        "requirement-covered"
      ]
    },
