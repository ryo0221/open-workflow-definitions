{
  "format": 1,
  "id": "fiction-novel",
  "version": "1.2.0",
  "title": "小説の制作",
  "purpose": "小説を、企画から人物・世界・筋・シーンの設計、章ごとの執筆、推敲・校正・通読を経て出版準備まで、作者が工程ごとに成果物を確かめて受け入れながら、AI の提案を採否して作る。",
  "phases": [
    {
      "id": "process",
      "name": "進め方",
      "purpose": "この作品で通る工程と省く工程、工程ごとの成果物と確かめる人、AI に頼むことの範囲、作品の出口を決める。",
      "after": [],
      "deliverables": [
        "process-map"
      ],
      "acceptance": [
        "process.complete",
        "process.ai-scope",
        "process.approved"
      ]
    },
    {
      "id": "concept",
      "name": "企画",
      "purpose": "何を誰に向けて書くか、読後に何を残すか、どの長さでどこへ出すかを決め、作者の文体の基準を作る。絵を使う作品では、画作りの決まり・レイヤーの決まり・採用見本をまとめた画作りガイドも作る。",
      "after": [
        "process"
      ],
      "deliverables": [
        "concept-doc",
        "voice-guide",
        "art-guide"
      ],
      "acceptance": [
        "concept.complete",
        "concept.approved",
        "voice.author-sample",
        "voice.approved",
        "art.layers-defined",
        "art.approved"
      ]
    },
    {
      "id": "character",
      "name": "人物",
      "purpose": "人物の欲求・傷・口調と、人物どうしの関係を決める。絵を使う作品では人物の設定画を描く。",
      "after": [
        "concept"
      ],
      "deliverables": [
        "character-sheet",
        "relationship-map",
        "character-art"
      ],
      "acceptance": [
        "character.complete",
        "character.approved",
        "character.art-layers",
        "character.art-approved"
      ]
    },
    {
      "id": "world",
      "name": "世界と舞台",
      "purpose": "物語の世界の決まりごと、舞台、固有名詞とその表記を決める。地図や絵を使う作品では、場所の配置を描いた地図と舞台の設定画も作る。",
      "after": [
        "concept"
      ],
      "deliverables": [
        "world-notes",
        "world-map",
        "stage-art",
        "term-dictionary"
      ],
      "acceptance": [
        "world.terms-unique",
        "world.approved",
        "world.map-approved",
        "world.art-layers",
        "world.art-approved"
      ]
    },
    {
      "id": "story",
      "name": "筋と構成",
      "purpose": "筋・出来事・伏線を置き、出来事の作中の時刻と人物ごとの経験の順を決め、構成の型と山場の配置を決める。読者への提示順は、シーンができてから構成図の提示位置で決める。",
      "after": [
        "character",
        "world"
      ],
      "deliverables": [
        "story-ledger",
        "structure-map"
      ],
      "acceptance": [
        "story.threads-themed",
        "story.foreshadowing-traced",
        "story.approved"
      ]
    },
    {
      "id": "scene",
      "name": "シーン設計",
      "purpose": "シーンごとに目的・視点・葛藤・変化・登場人物・場所を決め、構成図の提示位置に並べて章へ割り当てる。絵を使う作品では、シーンごとに人物の配置とカメラを決めたストーリーボードを描く。",
      "after": [
        "story"
      ],
      "deliverables": [
        "scene-cards",
        "storyboard"
      ],
      "acceptance": [
        "scene.traced",
        "scene.threads-covered",
        "scene.occurrences-traced",
        "scene.approved",
        "scene.storyboard-layers",
        "scene.storyboard-approved"
      ]
    },
    {
      "id": "draft",
      "name": "執筆",
      "purpose": "章ごとに本文を書く。章どうしは並行して、好きな順で書いてよい。",
      "after": [
        "scene"
      ],
      "deliverables": [
        "manuscript"
      ],
      "acceptance": [
        "draft.scenes-covered",
        "draft.terms",
        "draft.accepted"
      ]
    },
    {
      "id": "revise",
      "name": "推敲",
      "purpose": "構造・場面・文の順に原稿を見直し、指摘ごとに直すか、直さないか、意図として残すかを決める。",
      "after": [
        "draft"
      ],
      "deliverables": [
        "revision-record"
      ],
      "acceptance": [
        "revise.traced",
        "revise.decided"
      ]
    },
    {
      "id": "proof",
      "name": "校正",
      "purpose": "誤字・表記ゆれ・重複表現・ルビを直し、最終の表記を決める。",
      "after": [
        "revise"
      ],
      "deliverables": [
        "proof-record"
      ],
      "acceptance": [
        "proof.no-open",
        "proof.approved"
      ]
    },
    {
      "id": "read",
      "name": "通読",
      "purpose": "固定した版を通して読み、作品の完成を判断する。",
      "after": [
        "proof"
      ],
      "deliverables": [
        "editorial-record"
      ],
      "acceptance": [
        "read.fixed-version",
        "read.approved"
      ]
    },
    {
      "id": "output",
      "name": "出版準備",
      "purpose": "出口に合わせた形式で出力し、書誌情報と紹介文、AI の関わりの記録をそろえる。",
      "after": [
        "read"
      ],
      "deliverables": [
        "output-record"
      ],
      "acceptance": [
        "output.from-fixed",
        "output.approved"
      ]
    },
    {
      "id": "learning",
      "name": "学び",
      "purpose": "この作品で得たことのうち、次の作品で変えることを選んで残す。",
      "after": [
        "output"
      ],
      "deliverables": [
        "learning-record"
      ],
      "acceptance": [
        "learning.chosen"
      ]
    }
  ],
  "sections": [
    {
      "id": "plan",
      "name": "企画",
      "phases": [
        "process",
        "concept"
      ]
    },
    {
      "id": "design",
      "name": "物語設計",
      "phases": [
        "character",
        "world",
        "story",
        "scene"
      ]
    },
    {
      "id": "write",
      "name": "執筆",
      "phases": [
        "draft",
        "revise"
      ]
    },
    {
      "id": "finish",
      "name": "仕上げと公開",
      "phases": [
        "proof",
        "read",
        "output",
        "learning"
      ]
    }
  ],
  "deliverables": [
    {
      "id": "process-map",
      "name": "進め方",
      "form": "図",
      "outline": [
        {
          "heading": "工程の順",
          "describe": "通る工程と、その順とつながり"
        },
        {
          "heading": "工程ごとの成果物と確かめる人",
          "describe": "工程ごとに、作る成果物・達成条件・確かめる人"
        },
        {
          "heading": "省く工程",
          "describe": "省く工程と省く成果物（絵を使わない作品での画作りガイド・設定画・ストーリーボード、地図を使わない作品での地図など）と、その理由と代わりの確かめ方"
        },
        {
          "heading": "AI に頼むこと",
          "describe": "作品全体の既定として、AI に本文を書かせるか、提案だけか、読むだけかの範囲。章ごとに変えてよいかと、その決め方"
        },
        {
          "heading": "出口",
          "describe": "書き上げた作品をどこに出すか（投稿・公募・出版・私家版など）と、その規定の所在"
        }
      ]
    },
    {
      "id": "concept-doc",
      "name": "企画書",
      "form": "文書",
      "outline": [
        {
          "heading": "ログライン",
          "describe": "作品を一文で言うと何か"
        },
        {
          "heading": "テーマ",
          "describe": "作品が扱う問いと、読後に残したいもの",
          "item": "theme"
        },
        {
          "heading": "読者",
          "describe": "想定する読者と、その読者が作品に求めるもの"
        },
        {
          "heading": "長さ",
          "describe": "目標の文字数と章の数の目安"
        },
        {
          "heading": "結末までのあらすじ",
          "describe": "始まりから結末までの流れ。結末を伏せずに書く"
        },
        {
          "heading": "出口と規定",
          "describe": "出す先の規定（文字数・形式・AI の利用についての決まりなど）"
        }
      ],
      "uses": [
        "process-map"
      ]
    },
    {
      "id": "voice-guide",
      "name": "文体ガイド",
      "form": "文書",
      "outline": [
        {
          "heading": "視点と人称",
          "describe": "語り手、視点人物、人称の決まり"
        },
        {
          "heading": "時制",
          "describe": "語りの時制と、回想などの扱い"
        },
        {
          "heading": "文体の決まり",
          "describe": "語尾・文の長さ・比喩・会話文の書き方など、守る決まり",
          "item": "style-rule"
        },
        {
          "heading": "見本",
          "describe": "作者自身が書いた、この作品の文体の見本となる段落"
        }
      ],
      "uses": [
        "concept-doc"
      ]
    },
    {
      "id": "art-guide",
      "name": "画作りガイド",
      "form": "文書",
      "outline": [
        {
          "heading": "画作りの決まり",
          "describe": "線・形の誇張・配色・陰影・密度・カメラと演出・人物の固定した外見・許す例外など、守る決まり。絵を使わない作品では、進め方で省くと決めて空にしてよい",
          "item": "art-rule"
        },
        {
          "heading": "レイヤーの決まり",
          "describe": "レイヤーごとに、名前・重ね順・描く中身（下描き・線画・塗り・影・背景・効果・吹き出し・文字など）・使う段階（設定画・ラフ・線画・仕上げ）・分けたまま残すか、まとめてよいか・人と AI のどちらが描いてよいか。段階ごとに要るレイヤーと、ラフから線画・仕上げへ引き継ぐレイヤーも書く",
          "item": "layer"
        },
        {
          "heading": "採用見本",
          "describe": "見本ごとに、何の見本か・出典・利用条件・外へ送ってよいか・固定した版",
          "item": "sample"
        }
      ],
      "uses": [
        "concept-doc",
        "voice-guide"
      ]
    },
    {
      "id": "character-sheet",
      "name": "人物表",
      "form": "表",
      "outline": [
        {
          "heading": "人物",
          "describe": "人物ごとに、欲求・傷・口調・他の人物との関係・初めて出る場面",
          "item": "character"
        }
      ],
      "uses": [
        "concept-doc"
      ]
    },
    {
      "id": "relationship-map",
      "name": "相関図",
      "form": "図",
      "outline": [
        {
          "heading": "関係",
          "describe": "人物どうしの関係と、その関係が物語の中でどう変わるか"
        }
      ],
      "uses": [
        "character-sheet"
      ]
    },
    {
      "id": "character-art",
      "name": "人物の設定画",
      "form": "図",
      "outline": [
        {
          "heading": "人物ごとの設定画",
          "describe": "人物（CH）ごとに、正面・側面・背面・表情・衣装・持ち物。時期や世界で外見が変わるときは、変わる前と後を分けて描く。絵を使わない作品では、進め方で省くと決めて空にしてよい"
        },
        {
          "heading": "レイヤー",
          "describe": "設定画ごとに、使ったレイヤーを画作りガイドのレイヤーの決まりの名前で書く。決まりに無いレイヤーを足したときと、決まりで分けておくレイヤーをまとめたときは、その理由。人が描いた・直したレイヤーと、AI の提案を採ったレイヤー"
        }
      ],
      "uses": [
        "character-sheet",
        "art-guide"
      ]
    },
    {
      "id": "world-notes",
      "name": "世界の覚え書き",
      "form": "文書",
      "outline": [
        {
          "heading": "世界の決まり",
          "describe": "物語の世界で成り立つこと・成り立たないこと"
        },
        {
          "heading": "舞台",
          "describe": "場所ごとに、様子・位置関係・そこで起きうること",
          "item": "location"
        },
        {
          "heading": "世界線と時計",
          "describe": "作品の中の世界ごとに、親の世界（一つだけ）と、親から受け継ぐ出来事の集合とその固定した版、分岐を見せる時点、使う時計。時計ごとに、原点と、別の時計との整数日の差。受け継ぐ集合は時点から決めない"
        },
        {
          "heading": "世界間の移送",
          "describe": "人物や物が世界をまたぐごとに、どの個体が、どの出来事から出て、どの出来事に着き、何の情報を運ぶか。出発と到着の出来事は固定した版で引用する。時刻の計算とは別に書く"
        }
      ],
      "uses": [
        "concept-doc"
      ]
    },
    {
      "id": "world-map",
      "name": "地図",
      "form": "図",
      "outline": [
        {
          "heading": "場所の配置",
          "describe": "世界の覚え書きの場所（LO）ごとに、位置・向き・縮尺。時点や世界線で様子が変わる場所は、変わる前と後を分けて描き、どの出来事で変わるかを書く。地図を使わない作品では、進め方で省くと決めて空にしてよい"
        },
        {
          "heading": "道",
          "describe": "場所と場所のつながりごとに、道のりと、移動にかかる時間の目安"
        }
      ],
      "uses": [
        "world-notes"
      ]
    },
    {
      "id": "stage-art",
      "name": "舞台の設定画",
      "form": "図",
      "outline": [
        {
          "heading": "場所ごとの設定画",
          "describe": "場所（LO）ごとに、全景・主な向きからの見え方・時代と建築・明るさ。地図を作る作品では、地図と同じ向きと縮尺で描く。絵を使わない作品では、進め方で省くと決めて空にしてよい"
        },
        {
          "heading": "レイヤー",
          "describe": "設定画ごとに、使ったレイヤーを画作りガイドのレイヤーの決まりの名前で書く。決まりに無いレイヤーを足したときと、決まりで分けておくレイヤーをまとめたときは、その理由。人が描いた・直したレイヤーと、AI の提案を採ったレイヤー"
        }
      ],
      "uses": [
        "world-map",
        "art-guide"
      ]
    },
    {
      "id": "term-dictionary",
      "name": "固有名詞と表記の辞書",
      "form": "表",
      "outline": [
        {
          "heading": "用語",
          "describe": "用語ごとに、正しい表記・読み・ルビの有無・使わない表記",
          "item": "term"
        }
      ],
      "uses": [
        "world-notes",
        "character-sheet"
      ]
    },
    {
      "id": "story-ledger",
      "name": "筋の台帳",
      "form": "表",
      "outline": [
        {
          "heading": "筋",
          "describe": "物語を貫く筋ごとに、始まり・転機・決着",
          "item": "plot-thread"
        },
        {
          "heading": "出来事",
          "describe": "出来事ごとに、作中の時刻（未定・日・期間・幅、ほかの出来事からの日数）と、関わる人物の個体と場所、誰が何を知り・信じ・言ったか。シーンが無い出来事も書いてよい。読者への提示順はここに書かない",
          "item": "event"
        },
        {
          "heading": "伏線",
          "describe": "伏線ごとに、張る場所・回収する場所。回収しないときは理由（次作への持ち越し・意図したミスリードなど）",
          "item": "foreshadowing"
        }
      ],
      "uses": [
        "concept-doc",
        "character-sheet",
        "world-notes"
      ]
    },
    {
      "id": "structure-map",
      "name": "構成図",
      "form": "図",
      "outline": [
        {
          "heading": "構成の型",
          "describe": "選んだ構成の型（起承転結・三幕・序破急・独自など）"
        },
        {
          "heading": "山場の配置",
          "describe": "山場と転機を、全体のどこに置くか"
        },
        {
          "heading": "提示位置",
          "describe": "作品の中でシーンを読者に示す一回ごとに、示すシーン（固定した版）・並び・話や章。同じシーンをもう一度示すときは提示位置を別に作る。読者への提示順はここだけに書く",
          "item": "occurrence"
        },
        {
          "heading": "人物の経験の順",
          "describe": "人物の個体ごとに、本人が経験する出来事の順。作中の時刻や提示順とは別に書き、別の世界の出来事や、シーンの無い出来事も含めてよい。ほかの作品の経験の順とはつなげない"
        }
      ],
      "uses": [
        "story-ledger"
      ]
    },
    {
      "id": "scene-cards",
      "name": "シーンカード",
      "form": "表",
      "outline": [
        {
          "heading": "シーン",
          "describe": "シーンごとに、目的・視点人物・葛藤・変化・登場人物・場所と、描く出来事（固定した版）。並びと章は構成図の提示位置に書く。番号は章に依らず作品の中で固定し、使い回さない",
          "item": "scene"
        }
      ],
      "uses": [
        "story-ledger",
        "structure-map"
      ]
    },
    {
      "id": "storyboard",
      "name": "ストーリーボード",
      "form": "図",
      "outline": [
        {
          "heading": "シーンごとの絵",
          "describe": "シーン（SC）ごとに、要の場面の絵と、人物の配置（どの人物が、舞台のどこに、どちら向きに、どんな姿勢でいるか）とカメラの位置・向き・画角。挿絵や表紙のもとにも使う。絵を使わない作品では、進め方で省くと決めて空にしてよい"
        },
        {
          "heading": "レイヤー",
          "describe": "絵ごとに、使ったレイヤーを画作りガイドのレイヤーの決まりの名前で書く。決まりに無いレイヤーを足したときと、決まりで分けておくレイヤーをまとめたときは、その理由。人が描いた・直したレイヤーと、AI の提案を採ったレイヤー"
        }
      ],
      "uses": [
        "scene-cards",
        "character-art",
        "stage-art",
        "world-map"
      ]
    },
    {
      "id": "manuscript",
      "name": "章原稿",
      "form": "文書",
      "outline": [
        {
          "heading": "章の題",
          "describe": "章の本文。冒頭に、この章が書くシーンを並べる",
          "item": "chapter",
          "repeat": true
        }
      ],
      "uses": [
        "scene-cards",
        "voice-guide",
        "term-dictionary"
      ]
    },
    {
      "id": "revision-record",
      "name": "推敲の記録",
      "form": "表",
      "outline": [
        {
          "heading": "指摘",
          "describe": "指摘ごとに、対象・層（構造・場面・文）・出し手・判断（直す・直さない・意図として残す）とその理由",
          "item": "review"
        }
      ],
      "uses": [
        "manuscript"
      ]
    },
    {
      "id": "proof-record",
      "name": "校正の記録",
      "form": "表",
      "outline": [
        {
          "heading": "校正の一覧",
          "describe": "誤字・表記ゆれ・重複表現・ルビの指摘と、採るか採らないか"
        },
        {
          "heading": "表記の最終判断",
          "describe": "辞書にない表記の扱いを決めたこと"
        }
      ],
      "uses": [
        "manuscript",
        "term-dictionary"
      ]
    },
    {
      "id": "editorial-record",
      "name": "編集の記録",
      "form": "文書",
      "outline": [
        {
          "heading": "通読した版",
          "describe": "通して読んだ原稿の固定した版"
        },
        {
          "heading": "判断",
          "describe": "作品として完成とするかと、その理由"
        },
        {
          "heading": "残した例外",
          "describe": "意図して残した矛盾・語りの仕掛け・未回収の伏線と、その理由"
