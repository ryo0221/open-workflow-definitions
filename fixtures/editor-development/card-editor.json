{
  "fixture": 1,
  "id": "card-editor",
  "title": "カードの Editor",
  "purpose": "Editor のテンプレートが最初から持つカードの Editor（タイトル・説明・色を持つカード）を、この定義の項目と引用で書き直した見本。工程ごとに何を一件ずつ残すかの目安にする。",
  "definition": {
    "id": "editor-development",
    "version": "1.1.0"
  },
  "deliverables": {
    "process-map": {
      "note": "9 工程をすべて通す。リポジトリはテンプレートから作った専用のもの。取り込む Host は手元の PaoBub で、package は運用者が pin を確かめて信頼に登録する。各工程の承認は Editor の持ち主が 1 人で行う。"
    },
    "purpose-note": {
      "items": [
        {
          "id": "UR-01",
          "name": "アイデアを並べて比べる企画の担当者"
        },
        {
          "id": "OP-01",
          "name": "カードを足す",
          "cites": [
            "UR-01"
          ],
          "結果": "末尾に新しいカードが入り、Undo で消える"
        },
        {
          "id": "OP-02",
          "name": "カードのタイトル・説明・色を変える",
          "cites": [
            "UR-01"
          ],
          "結果": "「変更を適用」で 1 回の編集になる。「キャンセル」では変わらない"
        },
        {
          "id": "OP-03",
          "name": "カードを並べ替える・消す",
          "cites": [
            "UR-01"
          ],
          "結果": "1 回の操作が 1 回の Undo"
        },
        {
          "id": "OP-04",
          "name": "保存して再読込する",
          "cites": [
            "UR-01"
          ],
          "結果": "内容とカードの ID が保たれる"
        },
        {
          "id": "OP-05",
          "name": "空白だけのタイトルを入れる",
          "cites": [
            "UR-01"
          ],
          "結果": "拒否され、内容と履歴は変わらない"
        },
        {
          "id": "OP-06",
          "name": "外からのタイトル変更の提案を採るか捨てる",
          "cites": [
            "UR-01"
          ],
          "結果": "採るまで元の内容を変えない"
        },
        {
          "id": "EX-01",
          "name": "カード間の線や自由な配置（ホワイトボードに任せる）"
        }
      ]
    },
    "capability-matrix": {
      "items": [
        {
          "id": "CA-01",
          "name": "表示・編集・Undo",
          "cites": [
            "OP-01",
            "OP-02",
            "OP-03"
          ],
          "対応": "する"
        },
        {
          "id": "CA-02",
          "name": "保存と再読込",
          "cites": [
            "OP-04"
          ],
          "対応": "する"
        },
        {
          "id": "CA-03",
          "name": "操作提案（rename-card）",
          "cites": [
            "OP-06"
          ],
          "対応": "する"
        },
        {
          "id": "CA-04",
          "name": "共同編集",
          "対応": "しない",
          "しない理由・止め方": "manifest に宣言せず、入口を出さない"
        }
      ]
    },
    "format-spec": {
